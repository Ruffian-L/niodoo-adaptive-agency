# Copy to .env.local and edit. .env.local is gitignored and is read by every ./run
# subcommand. Use it to point at artifacts you already have, or to supply the ones
# that have no published URL yet.
#
# Every path is verified against the hash in manifest.toml before use. An override
# that fails its hash is rejected exactly like a bad download.

# Model weights and tokenizer. Omit these and ./run fetch will download them.
#ONE_SHOT_MODEL=/path/to/Meta-Llama-3.1-8B-Instruct-Q5_K_M.gguf
#ONE_SHOT_TOKENIZER=/path/to/tokenizer.json

# Binaries. Required until they are published as release assets.
#ONE_SHOT_NIODOO_BIN=/path/to/niodoo
#ONE_SHOT_LLAMA_CLI=/path/to/llama-cli

# Directory containing niodv4/data/results/summaries/ghost_candidate_registry.json
#ONE_SHOT_PRODUCT_ROOT=/path/to/product-root

# Extracted reference run, required by ./run verify only.
#ONE_SHOT_REFERENCE_RUN=/path/to/full-flag-reearn-20260809
